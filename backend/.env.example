# Replace these placeholders with a PostgreSQL database and role you provision.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/statcom
# A SEPARATE disposable database; never point tests at application data.
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/statcom_test
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Relative paths resolve from the backend process working directory.
VIDEO_STORAGE_PATH=./storage/videos
VIDEO_MAX_UPLOAD_BYTES=5368709120
FFPROBE_PATH=ffprobe
